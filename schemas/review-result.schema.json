{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitboss.local/schemas/review-result.schema.json",
  "title": "CircuitBoss Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "summary", "findings"],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "warnings", "suggestions", "information"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "suggestions": { "type": "integer", "minimum": 0 },
        "information": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "title",
          "explanation",
          "recommendation",
          "evidence",
          "objects",
          "confidence",
          "requires_datasheet_verification"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["critical", "warning", "suggestion", "information"] },
          "category": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id", "object_type", "object_id"],
              "properties": {
                "document_id": { "type": "string", "minLength": 1 },
                "object_type": { "type": "string", "minLength": 1 },
                "object_id": { "type": "string", "minLength": 1 }
              }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "requires_datasheet_verification": { "type": "boolean" }
        }
      }
    }
  }
}
